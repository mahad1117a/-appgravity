# Copy this file to .env and fill in real values before deploying.
# server.js now loads dotenv, so these are actually read (previously they were not).

# Port the Express server listens on
PORT=3000

# "production" enables secure cookies and hides error details from responses.
# Leave unset or "development" for local work.
NODE_ENV=production

# Comma-separated list of origins allowed to call the API (no trailing slashes).
# Must include your real frontend domain(s) in production.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Number of reverse proxy hops in front of this app (e.g. Nginx = 1).
# Set to 0 if the app is exposed directly with no reverse proxy.
TRUST_PROXY=1
