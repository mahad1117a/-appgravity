# Copy this file to .env and fill in real values before deploying.
# server.js now loads dotenv, so these are actually read (previously they were not).

# Port the Express server listens on
PORT=3000

# "production" enables secure cookies and hides error details from responses.
NODE_ENV=production

# Comma-separated list of origins allowed to call the API (no trailing slashes).
# ⚠️ BEFORE DEPLOYING: Replace these with your real domain(s) e.g. https://appsgravity.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mahad1117a.github.io/-appgravity/,https://mahad1117a.github.io/-appgravity/admin
# Number of reverse proxy hops in front of this app (e.g. Nginx = 1, Railway/Render = 1).
# Set to 0 if the app is exposed directly with no reverse proxy.
TRUST_PROXY=1

# ── ADMIN DASHBOARD (/admin) ──
